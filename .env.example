PORT=9000
FRONTEND_URL=http://localhost:4200
BACKEND_PROTOCOL_PROD=http

# Generate three DIFFERENT secrets; reused signing domains fail closed.
# Rotating these secrets invalidates existing sessions. Never reuse production keys.
JWT_SECRET_PATIENT=2GZHJuEbAfoL2byD5PRRQISaV7SAPQ1qqmkybJNhdmrUmT7rmx01R_uO1uVf-3VY
JWT_SECRET_DOC=LOaKRH3diSB5m_g1fkJFNzj9ZNfJvJC_HIIR104pWt4uMHwyHfbRr_9Gy15zO8do
JWT_SECRET_ADMIN=eudaBa40i6S_hBcRCiPpZfA5Sj-mgBMAm0jEuiypkD7AXNV4OB3aUcG36xFcoMe5
JWT_EXPIRES_IN=5h

# Local MySQL database. Create/import the required schema before starting.
DBHOST=127.0.0.1
DBUSER=root
DBPWD=replace_with_your_local_mysql_password
DBNAME=aims2health
EHR_DBNAME=medicdb

# Keep EHR integration disabled for local development.
EHR_CONNECT=false

# Required by the app during startup. Use rotated credentials.
TWILIO_AC_SID=replace_with_twilio_account_sid
TWILIO_AUTHTOKEN=replace_with_twilio_auth_token
TWILIO_VERIFY_SID=replace_with_twilio_verify_sid
TWILIO_MESSAGING_SID=replace_with_twilio_messaging_sid
TWILIO_PHONE_NUMBER=replace_with_twilio_phone_number

# Use a valid SendGrid key for email features; the value must start with SG.
SENDGRID_API_KEY=SG.replace_with_sendgrid_api_key
SENDGRID_FROM_ADDRESS=replace_with_verified_sender_address

# Use test-mode Razorpay credentials for local development.
RAZORPAY_KEY_ID=replace_with_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret

# Optional Zoom integration.
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_AC_ID=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_USER_ID=

# Optional application contact and upload settings.
ADMIN_PHONE=
ADMIN_EMAIL=
UPLOAD_LIMIT_WITHOUT_BOOKING=
UPLOAD_LIMIT_WITH_BOOKING=

# Optional ZeptoMail settings.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Aims2health
